{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fish Audio Asr API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Asr",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Speech-to-text",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fish.audio/v1/asr",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "audio",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "language",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ignore_timestamps",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Speech-to-text"
        }
      ]
    }
  ],
  "bundled": true
}